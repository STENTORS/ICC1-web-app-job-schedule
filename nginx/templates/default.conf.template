server {
    listen 80;

    # Serve static assets directly, don't proxy them to Flask.
    location /static/ {
        alias /usr/share/nginx/html/static/;
    }

    # Forward everything else to the Flask app. ${UPSTREAM_HOST} is filled
    # in by nginx's built-in envsubst-on-templates entrypoint at container
    # start - "app" via docker-compose, "localhost" on ECS Fargate.
    location / {
        proxy_pass http://${UPSTREAM_HOST}:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
